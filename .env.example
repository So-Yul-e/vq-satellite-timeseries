# PostgreSQL
# ⚠️ 아래 값들을 실제 값으로 변경하세요!
POSTGRES_USER=your_db_username
POSTGRES_PASSWORD=your_secure_password_here
POSTGRES_DB=vq_satellite
DATABASE_URL=postgresql://your_db_username:your_secure_password_here@postgres:5432/vq_satellite

# Redis & Celery
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0

# Security
# ⚠️ 프로덕션에서는 반드시 랜덤 문자열로 변경하세요!
# 생성 방법: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=your_random_secret_key_here

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000

# Email (Optional)
MAIL_USERNAME=your_email@gmail.com
MAIL_PASSWORD=your_gmail_app_password
MAIL_FROM=noreply@vq-satellite.com
MAIL_PORT=587
MAIL_SERVER=smtp.gmail.com

# API Keys (Optional)
SOLAR_API_KEY=your_solar_api_key_if_needed
SOLAR_PERMIT_API_KEY=your_permit_api_key_if_needed

# 산림청 산 정보 API — DEPRECATED, 좌표 기반 산지 판정 불가(이름 검색 API).
# 현재는 아래 VWorld 산림입지도로 대체됨. backend/verify_api.py 진단 스크립트만 참조.
FOREST_MOUNTAIN_API_KEY=your_data_go_kr_api_key

# VWorld(브이월드) — 항공정사영상 Image API + 산림입지도 Data API(산지 판정)
# 발급: https://www.vworld.kr (오픈API 인증키 발급, 활용 API: 2D지도/이미지/데이터 전체 신청 권장)
VWORLD_API_KEY=your_vworld_key
# 인증키 발급 시 등록한 서비스 URL의 호스트명(스킴/포트 제외). 기본값 localhost로 대부분 충분.
VWORLD_REQUEST_DOMAIN=localhost
